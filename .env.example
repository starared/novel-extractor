# OpenAI-compatible service; for Docker Desktop + local Ollama use
# http://host.docker.internal:11434/v1 and a model installed on that server.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
MODEL_API_KEY=
# Optional: PORT sets both container and server ports by default.
# PORT=53001
# Optional: override just the server port, independent of PORT.
# HOST_PORT=53002
# Optional: use Docker Hub instead of the Docker Official Images ECR mirror
# PYTHON_IMAGE=python:3.13-slim